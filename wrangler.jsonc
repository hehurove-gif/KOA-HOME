{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koa-home",
  "compatibility_date": "2026-11-01",
  // Worker de solo assets: sirve public/ tal cual (sin código de Worker).
  // El sitio vive en public/home/, así que se publica en <dominio>/home/.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Sin "routes": la ruta koa-hub.com/home* falló en el build porque la zona
  // koa-hub.com no se encontró en la cuenta/token de Workers Builds.
  // Cuando la zona esté en esta cuenta, agrégala desde el dashboard
  // (Worker > Settings > Domains & Routes) o restaura:
  // "routes": [{ "pattern": "koa-hub.com/home*", "zone_name": "koa-hub.com" }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
